<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Add/Update Quiz Section -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Quizzes"
        android:layout_marginTop="25dp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/dark_green"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/etQuizName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quiz Name"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etQuizDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quiz Description"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnAddQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:backgroundTint="@color/dark_green"
        android:padding="10dp"
        android:text="Add Quiz"
        android:textSize="16sp"
        android:textAllCaps="true"
        android:textColor="#ffffff"
        />

    <Button
        android:id="@+id/btnUpdateQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/light_green"
        android:padding="10dp"
        android:text="Update Quiz"
        android:textSize="16sp"
        android:textAllCaps="true"
        android:textColor="@color/dark_green"/>

    <!-- List of Quizzes -->
    <ListView
        android:id="@+id/listViewQuizzes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>